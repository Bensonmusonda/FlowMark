{
  "name": "flowmark",
  "version": "1.0.0",
  "description": "Minimal distraction-free markdown editor",
  "main": "src/main.js",
  "author": "Benson Musonda",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --outfile=src/editor.bundle.js --format=iife --platform=browser",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:ci": "npm run build && electron-builder --win --publish never",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.bensonmusonda.flowmark",
    "productName": "FlowMark",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.27.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.3",
    "katex": "^0.19.1",
    "marked": "^12.0.0"
  }
}
